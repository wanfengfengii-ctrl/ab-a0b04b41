{
  "name": "trio-haplotype-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Phased variant haplotype transmission audit for father/mother/child trios",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "smoke": "node dist/smoke.js",
    "verify": "npm run build && npm test && npm run smoke"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
